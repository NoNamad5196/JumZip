VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_AUTH_GOOGLE_ENABLED=false
VITE_AUTH_EMAIL_ENABLED=false
VITE_LLM_PROVIDER_NAME=
VITE_LLM_PROVIDER_REGION=
VITE_LLM_PRIVACY_URL=
# The following are server-only. Put local values in .env.server.local,
# and production values in Supabase Secrets; never prefix secrets with VITE_.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_STRUCTURED_FORMAT=json_object
LLM_PROVIDER_NAME=
LLM_PROVIDER_REGION=
LLM_PRIVACY_URL=
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Optional kill switches. Omitted/true enables each feature.
TOOL_RECOMMENDATIONS_ENABLED=true
TITLE_GENERATION_ENABLED=true
MEMORY_MAINTENANCE_ENABLED=true
